{
  "name": "bun-htmx-crud",
  "module": "src/index.ts",
  "type": "module",
  "version": "1.0.2",
  "scripts": {
    "update:types": "wrangler types",
    "build:client": "bun build client/src/*.ts --outdir public/javascript/ --target browser --minify --entry-naming '/[name].[ext]'",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "create:db": "wrangler d1 create htmx-crud",
    "migrate:create": "drizzle-kit generate",
    "migrate:dev": "wrangler d1 migrations apply htmx-crud --local",
    "migrate": "wrangler d1 migrations apply htmx-crud --remote",
    "test:db:dev": "wrangler d1 execute htmx-crud --local --command \"select * from products\";",
    "test:db": "wrangler d1 execute htmx-crud --remote --command \"select * from products\";",
    "dev": "bun run build:client && wrangler dev",
    "deploy:app": "bun run build:client && wrangler deploy",
    "secret:github": "wrangler secret put GITHUB_CLIENT_SECRET",
    "secret:google": "wrangler secret put GOOGLE_CLIENT_SECRET",
    "logtail": "wrangler tail htmx-crud",
    "rollback:app": "wrangler rollback",
    "delete:app": "wrangler delete",
    "databases": "wrangler d1 list",
    "studio:db": "drizzle-kit studio",
    "studio:db:dev": "cross-env LOCAL_DB_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print0 | xargs -0 ls -t | head -1) drizzle-kit studio --config=drizzle.config.local.ts",
    "introspect:db": "drizzle-kit introspect",
    "dbcat:db:dev": "cross-env find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print0 | xargs -0 ls -t | head -1 | xargs bunx dbcat"
  },
  "dependencies": {
    "@elysiajs/html": "^1.4.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "typedi": "^0.10.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "typed-html": "^3.0.1",
    "wrangler": "^4.112.0"
  }
}
